// dsh_VolumeCloud.dsh -- a DreamShader header: functions shared by the materials that import it.
// Import it from a .dsm with:  import "dsh_VolumeCloud.dsh";
Function float Luma(in vec3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

// SkyCoordDebug -- 世界坐标可视化。把世界 XY（cm）按瓦片边长（km）平铺，
// 取每个 2km 格内的分数坐标拼成 (x, y, 0) 的 RGB，接入 basecode 即可直观看到天空坐标分布。
// 对应节点图：AbsoluteWorldPosition.xy -> Divide(TileKm*100000) -> Frac -> Append(0) -> DebugUV。
// UE.WorldPosition() 会被提升为真实节点，并作为该 Custom 节点的引脚输入。
GraphFunction float3 SkyCoordDebug(in float Tile_Km)
{
    float3 wp     = UE.WorldPosition();
    float  tileCm = Tile_Km * 100000.0;      // km -> cm，与世界位置单位对齐
    float2 uv     = frac(wp.xy / tileCm);
    return float3(uv, 0.0);
}

// MkCircle -- 基于 UV 坐标和半径输出硬边圆形蒙版。
// Tile: 1 = 平铺，UV 经 frac() 包裹，圆心固定在 (0.5, 0.5) 并在每个 UV 瓦片内重复；
//       0 = 不平铺，直接使用原始 UV。返回值 1.0 表示圆内，0.0 表示圆外。
Function float MkCircle(in float2 UV, in float Radius, in float Tile)
{
    float2 uv = lerp(UV, frac(UV), Tile); // Tile: 1 = 平铺(frac 包裹)；0 = 不平铺
    float2 center = float2(0.5, 0.5);
    float dist = length(uv - center);
    return 1.0 - step(Radius, dist);
}

// MkCircleSoft -- 基于 UV 坐标和半径输出软边圆形蒙版。
// Tile: 1 = 平铺，UV 经 frac() 包裹，圆心固定在 (0.5, 0.5) 并在每个 UV 瓦片内重复；
//       0 = 不平铺，直接使用原始 UV。返回值 1.0 表示圆内，0.0 表示圆外。
// Softness 控制边缘过渡宽度：0 为硬边，值越大边缘越柔和。
Function float MkCircleSoft(in float2 UV, in float Radius, in float Softness, in float Tile)
{
    float2 uv = lerp(UV, frac(UV), Tile); // Tile: 1 = 平铺(frac 包裹)；0 = 不平铺
    float2 center = float2(0.5, 0.5);
    float dist = length(uv - center);
    return 1.0 - smoothstep(Radius - Softness, Radius + Softness, dist);
}

// 目的：基于云层归一化高度，降低底部和顶部云层的渲染精度
// 使用：与 Extinct 相乘
GraphFunction float TD_BiinearGradient()
{
    float NormAltitudeInLayer = UE.CloudSampleAttribute(OutputType="float1", OutputName="NormAltitudeInLayer");
    return NormAltitudeInLayer = 1 - abs((NormAltitudeInLayer - 0.5) * 2); // 让密度集中在云层中间
}

// 工具函数

// 将任意范围值归一化
GraphFunction float RemapValue_Normalized(in float Input, in float Low, in float High)
{
    return saturate((Input - Low) / max(High - Low, 0.0001));
}