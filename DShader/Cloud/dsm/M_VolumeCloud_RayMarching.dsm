// M_VolumeCloud_RayMarching.dsm -- 射线步进体积云材质。
// 由 MF_Module_Volumetric_Cloud.ush 移植而来。立方体随相机跟随（WPO），
// 对 3D 密度纹理做射线步进，包含 Beer-Lambert 消光、解析云阴影、
// 背光边缘光（Silver Lining）、天空环境光和时域抖动。
// 生成 /Game/Cloud/dsm/M_VolumeCloud_RayMarching（项目默认 ThinCustom 后端 -> 材质实例）。
Shader(Name="Cloud/dsm/M_VolumeCloud_RayMarching")
{
    Properties = {
        // 体积云基础参数
        Group("体积云") {
            Texture3D CloudTex = Path(Game, "Cloud/Texture/Volume/T_Volume_VolumeCloud_03") [
                Description = "3D 云密度贴图（采样较红通道 .r 作密度）";
                ParameterName = "云纹理";
            ];
            vec3 CloudColor = vec3(0.8, 0.8, 0.8) [
                Description = "云体颜色乘数";
                ParameterName = "云颜色";
            ];
            float CloudOpacityStrength = 8.0 [
                Slider(1, 80);
                Description = "Beer-Lambert 消光密度，越大越不透明";
                ParameterName = "不透明度强度";
            ];
            float CloudSteps = 24.0 [
                Slider(16, 128);
                Description = "射线步进采样步数";
                ParameterName = "采样步数";
            ];
            float CloudShadowSteps = 8.0 [
                Slider(2, 16);
                Description = "阴影射线采样步数";
                ParameterName = "阴影采样步数";
            ];
            float CloudShadowRange = 0.3 [
                Slider(0.1, 3);
                Description = "阴影射线在 UVW 空间中的总长度";
                ParameterName = "阴影长度";
            ];
            float CloudShadowOffset = 2.0 [
                Slider(-2, 2);
                Description = "阴影步进起点沿阳光方向（朝太阳）偏移的步数";
                ParameterName = "阴影起点偏移";
            ];
            float CloudShadowStrength = 8.0 [
                Slider(0.5, 80);
                Description = "阴影吸收乘数，越大阴影越厚";
                ParameterName = "阴影强度";
            ];
            float CloudSilverLining = 2.0 [
                Slider(0, 5);
                Description = "背光边缘光强度，0 关闭；仅视线看向太阳方向时生效";
                ParameterName = "背光边缘光强度";
            ];
            float CloudSilverLiningBackPower = 2.5 [
                Slider(0.5, 8);
                Description = "视线与阳光方向夹角的过渡锐度";
                ParameterName = "背光方向锐度";
            ];
            float CloudDitherScale = 1.0 [
                Slider(0, 2);
                Description = "采样起点抖动幅度（以步长为单位），需配合 TAA";
                ParameterName = "抖动强度";
            ];
            vec3 CloudAmbient = vec3(0.32, 0.37, 0.40) [
                Description = "(已废弃) 天空环境光兜底颜色；现改为天空SH辐照度，参数保留仅为兼容旧实例";
                ParameterName = "环境光颜色";
            ];
            float CloudBoundaryFade = 0.08 [
                Slider(0, 0.5);
                Description = "包围盒边界淡出宽度（UVW单位）。防止盒子面把云硬切断成白色轮廓；值越大边缘越柔和";
                ParameterName = "边界淡出宽度";
            ];
        }

        // 体积云侵蚀
        Group("体积云侵蚀") {
            Texture3D CloudNoiseTex = Path(Engine, "EngineSky/VolumetricClouds/VT_PerlinWorley_Balanced") [
                Description = "侵蚀噪声纹理（引擎自带 VT_PerlinWorley_Balanced，Perlin/Worley 混合，.r 通道作侵蚀值，wrap 平铺）";
                ParameterName = "侵蚀噪声纹理";
            ];
            vec3 CloudWindSpeed = vec3(0.0, 0.0, 4.0) [
                Description = "世界空间风速（米/秒）。云噪声场沿此方向随时间漂移";
                ParameterName = "风速度";
            ];
            float CloudNoiseFreq = 0.01 [
                Slider(0.001, 0.05);
                Description = "侵蚀噪声空间频率（每米）。越大噪声越细碎";
                ParameterName = "噪声频率";
            ];
            float CloudErosionStrength = 0.35 [
                Slider(0, 2);
                Description = "侵蚀强度。噪声从云剖面中削掉的比例，越大边缘越破碎/丝缕";
                ParameterName = "侵蚀强度";
            ];
            float CloudErosionNoiseOffset = 0.5 [
                Slider(0, 1);
                Description = "侵蚀噪声阈值偏移。抬高则侵蚀更弱（只有高噪声区被削），调低则整体更碎";
                ParameterName = "侵蚀噪声阈值";
            ];
        }
    }

    Settings = {
        Domain       = "Surface";
        ShadingModel = "Unlit";
        BlendMode    = "AlphaComposite";
        TwoSided     = true;
        bAlwaysEvaluateWorldPositionOffset = true;
    }

    Outputs = {
        vec3  Emissive;
        float Opacity;
        vec3  WPO;

        Base.EmissiveColor     = Emissive;
        Base.Opacity           = Opacity;
        Base.OpacityMask       = Opacity;
        Base.WorldPositionOffset = WPO;
    }

    Graph = {
        float4 RM = CloudRayMarch(
            CloudTex, CloudColor, CloudOpacityStrength, CloudSteps,
            CloudShadowSteps, CloudShadowRange, CloudShadowOffset,
            CloudShadowStrength, CloudSilverLining, CloudSilverLiningBackPower,
            CloudDitherScale, CloudBoundaryFade,
            CloudNoiseTex, CloudWindSpeed, CloudNoiseFreq,
            CloudErosionStrength, CloudErosionNoiseOffset);

        WPO      = CloudWPO();
        Emissive = RM.rgb;
        Opacity  = RM.a;
    }
}

// WPO：仅当相机完全进入立方体内部后，才把立方体中心平移到相机上（居中跟随）。
// 触发判定不再外扩余量：此前用 BMin-Snap..BMax+Snap（Snap=半盒宽）作触发带，
// 相机还在盒外就会整盒"全额居中"跳变（位移量可达一个整盒宽），
// 把相机提前包进一个"空心"跟随盒，同时整帧构图/覆盖突变 -> 云提前位移 + 亮度骤变。
// 现改为严格按各轴真实边界判断，只有真正进入盒子后才开始居中跟随。
// 输出为 translated world 空间。完全在 primitive（local）空间内计算，以缩短 LWC 数学；
// 只有最终的局部位移再经 LocalToWorld 3x3 旋转/缩放回世界空间。
GraphFunction CloudWPO(out float3 WPO)
{
    float3 BMin = GetPrimitiveData(Parameters).LocalObjectBoundsMin;
    float3 BMax = GetPrimitiveData(Parameters).LocalObjectBoundsMax;
    float3 BCenter = (BMin + BMax) * 0.5;

    // 相机转 primitive 空间 -- 与 CloudRayMarch 中的一致：
    // DFFastMultiplyDemote(ResolvedView.WorldCameraOrigin, GetPrimitiveData(Parameters).WorldToLocal)
    float3 CamLocal =
        DFFastMultiplyDemote(ResolvedView.WorldCameraOrigin, GetPrimitiveData(Parameters).WorldToLocal).xyz;

    // 相机完全进入盒子（各轴严格落在真实边界内）才触发跟随
    float Inside = 0.0;
    if (CamLocal.x > BMin.x && CamLocal.x < BMax.x) {
        if (CamLocal.y > BMin.y && CamLocal.y < BMax.y) {
            if (CamLocal.z > BMin.z && CamLocal.z < BMax.z) {
                Inside = 1.0;
            }
        }
    }

    float3 LocalDelta = (CamLocal - BCenter) * Inside;
    // 注意用行向量*矩阵（与 CloudRayMarch 中 RStepLocal/EntryDeltaLocal 的写法一致）；
    // 之前 mul(矩阵, LocalDelta) 是转置乘，actor 带旋转时位移方向会被镜像。
    WPO = mul(LocalDelta, GetLocalToWorld3x3(Parameters));
}

// 像素射线步进。返回预乘颜色 + 不透明度。
GraphFunction CloudRayMarch(
    in Texture3D CloudTex,
    in float3 CloudColor,
    in float CloudOpacityStrength,
    in float CloudSteps,
    in float CloudShadowSteps,
    in float CloudShadowRange,
    in float CloudShadowOffset,
    in float CloudShadowStrength,
    in float CloudSilverLining,
    in float CloudSilverLiningBackPower,    in float CloudDitherScale,
    in float CloudBoundaryFade,
    in Texture3D CloudNoiseTex,
    in float3 CloudWindSpeed,
    in float CloudNoiseFreq,
    in float CloudErosionStrength,
    in float CloudErosionNoiseOffset,
    out float4 RM)
{
    float3 BMin = GetPrimitiveData(Parameters).LocalObjectBoundsMin;
    float3 BMax = GetPrimitiveData(Parameters).LocalObjectBoundsMax;
    float3 BSize = max(BMax - BMin, 0.001);

    // 相机 -> primitive -> UVW（含参考所用的 Rx(90°) Y 轴向上补偿）
    float3 CamLocal =
        DFFastMultiplyDemote(ResolvedView.WorldCameraOrigin, GetPrimitiveData(Parameters).WorldToLocal).xyz;
    float3 CamUVW = (CamLocal - BMin) / BSize;
    CamUVW = float3(CamUVW.x, 1.0 - CamUVW.z, CamUVW.y);

    // 世界空间视线方向，由像素重建（不依赖表面位置）。
    float4 Sv = Parameters.SvPosition;
    float3 RayDirWorld = normalize(
        SvPositionToTranslatedWorld(float4(Sv.xy, 1.0, Sv.w))
        - ResolvedView.TranslatedWorldCameraOrigin);

    float3x3 W2L3 = DFToFloat3x3(GetPrimitiveData(Parameters).WorldToLocal);

    float3 ViewDirLocal = mul(RayDirWorld, W2L3);
    float3 ViewDir = ViewDirLocal / BSize;
    ViewDir = float3(ViewDir.x, -ViewDir.z, ViewDir.y);
    ViewDir = normalize(ViewDir);

    float3 ToLight = normalize(ResolvedView.DirectionalLightDirection);
    ToLight = mul(ToLight, W2L3);
    ToLight = ToLight / BSize;
    ToLight = float3(ToLight.x, -ToLight.z, ToLight.y);
    ToLight = normalize(ToLight);

    // AABB（射线与单位立方体求交）
    float3 InvD = 1.0 / (ViewDir + 0.00001);
    float3 t0 = -CamUVW * InvD;
    float3 t1 = (1.0 - CamUVW) * InvD;
    float3 tN = min(t0, t1);
    float3 tF = max(t0, t1);
    float tEntry = max(max(max(tN.x, tN.y), tN.z), 0.0);
    float tExit  = min(min(tF.x, tF.y), tF.z);

    RM = float4(0, 0, 0, 0);

    if (tExit > tEntry) {
        // 遮挡体：沿本像素射线的场景深度，换算到 primitive 空间。
        float SceneDepth = CalcSceneDepth(ScreenAlignedPosition(GetScreenPosition(Parameters)));
        float RayDist = SceneDepth / max(dot(RayDirWorld, ResolvedView.ViewForward), 0.0001);
        // 遮挡体 local = 相机 local + （世界射线位移 -> local，经 3x3 线性部分）
        float3 OccLocal = CamLocal + mul(RayDirWorld * RayDist, W2L3);
        float3 OccUVW = (OccLocal - BMin) / BSize;
        OccUVW = float3(OccUVW.x, 1.0 - OccUVW.z, OccUVW.y);
        float tOcc = dot(OccUVW - CamUVW, ViewDir);

        float3 Entry = clamp(CamUVW + ViewDir * tEntry, 0.001, 0.999);
        float3 Exit  = clamp(CamUVW + ViewDir * tExit,  0.001, 0.999);
        float3 RStep = (Exit - Entry) / max(CloudSteps, 16.0);
        float tStep  = (tExit - tEntry) / max(CloudSteps, 16.0);

        // 时域抖动（interleaved gradient noise），内联以不依赖 IGN 头文件
        // 是否在材质编译链中。
        float2 dn = Parameters.SvPosition.xy + ResolvedView.StateFrameIndexMod8 * (float2(47.0, 17.0) * 0.695);
        float Dither = frac(52.9829189 * frac(dot(dn, float2(0.06711056, 0.00583715))));

        float tCur = tEntry;
        Entry += RStep * (Dither - 0.5) * max(CloudDitherScale, 0.0);
        Entry = clamp(Entry, 0.001, 0.999);
        tCur += (Dither - 0.5) * max(CloudDitherScale, 0.0) * tStep;

        float StepLen = length(RStep);

        // 世界坐标流动/侵蚀采样所需的世界步进量。
        // 把 UVW 步长经"逆 swizzle + BSize"转回 primitive-local，再经 LocalToWorld 3x3 转世界。
        // ViewDir 经 (x, -z, y) 的方向 swizzle，故方向逆 swizzle 为 (x, z, -y)。
        float3 RStepLocal = float3(RStep.x, RStep.z, -RStep.y) * BSize;
        float3 RStepWorld = mul(RStepLocal, GetLocalToWorld3x3(Parameters));
        float WorldStep = dot(RStepWorld, RayDirWorld);
        // 起始世界距离 = UVW 入口相对相机（局部坐标）经旋转/缩放后的世界位移，投影到世界视线方向。
        // Cur 每步增长 RStep（UVW），故世界距离按 WorldStep 累加即可，初始即入口偏移。
        float3 EntryDeltaLocal = float3(Entry.x - CamUVW.x, Entry.z - CamUVW.z, -(Entry.y - CamUVW.y)) * BSize;
        float3 EntryDeltaWorld = mul(EntryDeltaLocal, GetLocalToWorld3x3(Parameters));
        float WorldDist = dot(EntryDeltaWorld, RayDirWorld);

        int ShSteps = max((int)CloudShadowSteps, 2);
        float3 ShStep = ToLight * CloudShadowRange / (float)ShSteps;

        float3 LCol = max(ResolvedView.DirectionalLightColor.rgb, float3(0, 0, 0));
        float CosT = clamp(dot(ViewDir, ToLight), -0.999, 0.999);
        float BackLit = pow(saturate(CosT), max(CloudSilverLiningBackPower, 0.5));

        // 天空环境光：
        // 读取完整 View.SkyIrradianceEnvironmentMap 的 L0 常数项（天空平均辐照度）。
        // ResolvedView 是精简 ViewState，不含该 SH 字段，因此这里必须用 View。
        float3 SkyAmbient = max(float3(0, 0, 0), float3(
            View.SkyIrradianceEnvironmentMap[0].w,
            View.SkyIrradianceEnvironmentMap[1].w,
            View.SkyIrradianceEnvironmentMap[2].w)) * ResolvedView.SkyLightColor.rgb;

        float3 Cur = Entry;
        float3 Col = float3(0, 0, 0);
        float Tr = 1.0;

        [loop]
        for (int i = 0; i < (int)CloudSteps; i++)
        {
            Cur = clamp(Cur, 0.001, 0.999);

            float4 Samp = Texture3DSample(CloudTex, CloudTexSampler, Cur);
            float Den = saturate(Samp.r);

            // 边界淡出：沿射线到最近盒面（UVW 空间 [0,1]）的距离线性衰减密度。
            // 没有这层衰减时，盒子面处密度仍非零，云被盒子硬切断成白色轮廓。
            float FadeDist = min(min(min(Cur.x, 1.0 - Cur.x), min(Cur.y, 1.0 - Cur.y)), min(Cur.z, 1.0 - Cur.z));
            Den *= saturate(FadeDist / max(CloudBoundaryFade, 0.0001));

            // 侵蚀 + 流动（参考 vapor SampleUprezzedCloudDensity）。
            // 流动在世界空间做：Swept = 世界采样点 - WindSpeed * GameTime，再乘空间频率。
            // CloudTex 本身每朵云边缘→0 内部→1，故直接以 Den 作剖面做 ValueErosion 侵蚀。
            if (max(CloudErosionStrength, 0.0) > 0.001)
            {
                // 前采样点的世界坐标（绝对世界，固定于世界空间）。
                // 必须用 WorldCameraOrigin（绝对世界）而非 TranslatedWorldCameraOrigin（随相机平移），
                // 否则侵蚀噪声场锚定在相机上、随屏幕移动。
                // WorldCameraOrigin 是 LWC double（FDFVector3），需先 DFHackToFloat 降精度到 float3 再与偏移相加。
                float3 WorldSample = DFHackToFloat(ResolvedView.WorldCameraOrigin) + RayDirWorld * WorldDist;
                float3 SweptUVW = WorldSample - CloudWindSpeed * UE.Time();
                float3 NoiseUVW = SweptUVW * max(CloudNoiseFreq, 0.00001);
                float NoiseVal = saturate(Texture3DSample(CloudNoiseTex, CloudNoiseTexSampler, NoiseUVW).r);

                float ErosionVal = saturate((NoiseVal - CloudErosionNoiseOffset) / max(1.0 - CloudErosionNoiseOffset, 0.0001));
                ErosionVal *= CloudErosionStrength;
                float InvE = max(1.0 - ErosionVal, 0.0001);
                Den = saturate((Den - ErosionVal) / InvE);
            }

            if (tCur <= tOcc && Den >= 0.02 && Tr > 0.003)
            {
                float Sigma = Den * CloudOpacityStrength;
                float StepTr = exp(-Sigma * StepLen);

                float Shadow = 1.0;
                {
                    float SAcc = 0.0;
                    [loop]
                    for (int s = 0; s < ShSteps; s++)
                    {
                        float3 Sc = clamp(Cur + ShStep * ((float)(s + 1) + CloudShadowOffset), 0.001, 0.999);
                        float SRaw = saturate(Texture3DSample(CloudTex, CloudTexSampler, Sc).r);
                        if (SRaw >= 0.02) {
                            SAcc += SRaw;
                        }
                    }
                    Shadow = exp(-SAcc * CloudShadowStrength / (float)ShSteps);
                }

                float3 Direct = LCol * Shadow;
                float EdgeMask = Den * (1.0 - Den) * 4.0;
                Direct += LCol * EdgeMask * BackLit * Shadow * CloudSilverLining;

                float AltFade = lerp(1.0, 0.1, saturate(Cur.y));
                // 环境光使用天空SH辐照度，随日夜/天光实时变化；
                // 这里不乘太阳 Shadow（天空环境光不是太阳直射光），
                // 由 AltFade 做云底垂直方向的渐隐。
                float3 Ambient = SkyAmbient * AltFade;

                float3 Lighting = Direct + Ambient;
                Col += Tr * (1.0 - StepTr) * Lighting;
                Tr *= StepTr;
            }

            Cur += RStep;
            tCur += tStep;
            WorldDist += WorldStep;
        }

        RM = float4(Col * CloudColor.rgb, 1.0 - Tr);
    }
}
